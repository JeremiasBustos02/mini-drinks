{
  "name": "mini-drinks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/**/*.test.ts",
    "test:integration:postgres": "tsx tests/integration/postgres/concurrency.ts",
    "db:test:migrate": "tsx tests/integration/postgres/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "db:add-admin": "tsx --conditions=react-server lib/db/add-admin.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "drizzle-orm": "^0.45.2",
    "mercadopago": "^3.6.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "postcss": "^8.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  }
}
