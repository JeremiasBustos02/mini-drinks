# Supabase transaction pooler URL for Next.js/Vercel runtime queries.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase direct URL or session pooler URL for Drizzle migrations.
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Public project settings used by Supabase Auth. The publishable key is safe to
# expose; authorization never depends on secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Mercado Pago Checkout Pro credentials. Never prefix these with NEXT_PUBLIC_.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Canonical public origin used for Mercado Pago return and webhook URLs.
# Local example: http://localhost:3000. Preview/production must use their public HTTPS origin.
APP_URL=http://localhost:3000

# Optional; defaults to 15 minutes.
STOCK_RESERVATION_MINUTES=15
